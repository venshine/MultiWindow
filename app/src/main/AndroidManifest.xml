<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".DemoApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
            除 ConfigActivity 外都声明 configChanges，由页面自己处理窗口尺寸变化（不重建）；
            supportsPictureInPicture 也要求同时声明 configChanges。
            <layout> 的默认尺寸和最小尺寸只在自由窗口（桌面窗口）模式下用于首次启动。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:resizeableActivity="true">
            <layout
                android:defaultWidth="600dp"
                android:defaultHeight="500dp"
                android:gravity="top|end"
                android:minWidth="100dp"
                android:minHeight="150dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".StatusActivity" android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation" android:exported="false" />
        <activity android:name=".AdjacentActivity" android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation" android:exported="false" />
        <activity android:name=".PeerActivity" android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation" android:exported="false">
            <layout
                android:defaultWidth="300dp"
                android:defaultHeight="300dp"
                android:gravity="top|end"
                android:minWidth="100dp"
                android:minHeight="100dp" />
        </activity>
        <activity android:name=".DragActivity" android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation" android:exported="false" />
        <activity
            android:name=".PipActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="false"
            android:supportsPictureInPicture="true" />

        <!-- 不声明 configChanges：尺寸变化会重建 Activity，用来演示 ViewModel 保留状态 -->
        <activity android:name=".ConfigActivity" android:exported="false" />
    </application>

</manifest>
