<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
            supportsPictureInPicture 要求同时声明 configChanges，由本页自己处理窗口变化；
            <layout> 的默认尺寸和最小尺寸只在自由窗口（桌面窗口）模式下用于首次启动。
        -->
        <activity
            android:name=".FirstActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true">
            <layout
                android:defaultWidth="600dp"
                android:defaultHeight="500dp"
                android:gravity="top|end"
                android:minWidth="100dp"
                android:minHeight="150dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 不声明 configChanges：尺寸变化会重建 Activity，用来演示 ViewModel 保留状态 -->
        <activity
            android:name=".SecondActivity"
            android:exported="false"
            android:resizeableActivity="true">
            <layout
                android:defaultWidth="300dp"
                android:defaultHeight="300dp"
                android:gravity="top|end"
                android:minWidth="100dp"
                android:minHeight="100dp" />
        </activity>
    </application>

</manifest>
