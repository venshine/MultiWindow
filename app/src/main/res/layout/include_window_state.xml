<?xml version="1.0" encoding="utf-8"?>
<!-- 窗口状态三格：尺寸、多窗口、画中画；由 BaseActivity.bindWindowState 填充 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:background="@drawable/bg_stat"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/state_size" />

        <TextView
            android:id="@+id/state_size"
            style="@style/Text.Numeric"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cell_multi"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_stat"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/state_multi" />

        <TextView
            android:id="@+id/state_multi"
            style="@style/Text.Numeric"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/stat_text"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cell_pip"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_stat"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/state_pip" />

        <TextView
            android:id="@+id/state_pip"
            style="@style/Text.Numeric"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/stat_text"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
